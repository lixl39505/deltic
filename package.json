{
  "name": "deltic",
  "version": "0.2.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lixl39505/deltic.git"
  },
  "description": "Gulp-based incremental compile toolkit: compiler, plugins, compile cache, dependency graph.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "deltic": "bin/deltic.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "pnpm build",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && vitest run test/e2e",
    "bench": "pnpm build && node bench/run.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "preversion": "pnpm test",
    "version": "git add -A",
    "postversion": "git push && git push --tags"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "gulp": "^5.0.1",
    "jiti": "^2.7.0",
    "json5": "^2.2.3",
    "micromatch": "^4.0.8",
    "picocolors": "^1.1.1",
    "streamx": "^2.28.1",
    "vinyl": "^3.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^26.6.3",
    "@types/vinyl": "^2.0.12",
    "@vitest/coverage-istanbul": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
